set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(MF_TOOLCHAIN_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.build/toolchains/usr" CACHE PATH "Cross toolchains")
get_filename_component(MF_TOOLCHAIN_ROOT "${MF_TOOLCHAIN_ROOT}" ABSOLUTE)
set(CMAKE_C_COMPILER "${MF_TOOLCHAIN_ROOT}/bin/aarch64-linux-gnu-gcc")
set(CMAKE_CXX_COMPILER "${MF_TOOLCHAIN_ROOT}/bin/aarch64-linux-gnu-g++")
set(CMAKE_FIND_ROOT_PATH "${MF_TOOLCHAIN_ROOT}/aarch64-linux-gnu")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_SYSROOT "${MF_TOOLCHAIN_ROOT}/..")
