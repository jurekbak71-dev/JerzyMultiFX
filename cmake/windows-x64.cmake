set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(MF_TOOLCHAIN_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.build/toolchains/usr" CACHE PATH "Cross toolchains")
get_filename_component(MF_TOOLCHAIN_ROOT "${MF_TOOLCHAIN_ROOT}" ABSOLUTE)
set(CMAKE_C_COMPILER "${MF_TOOLCHAIN_ROOT}/bin/x86_64-w64-mingw32-gcc-posix")
set(CMAKE_CXX_COMPILER "${MF_TOOLCHAIN_ROOT}/bin/x86_64-w64-mingw32-g++-posix")
set(CMAKE_RC_COMPILER "${MF_TOOLCHAIN_ROOT}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${MF_TOOLCHAIN_ROOT}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
