[Unit]
Description=Jerzy MultiFX dedicated JACK server
After=sound.target
[Service]
User=jerzymultifx
EnvironmentFile=/etc/jerzy-multifx/audio.env
ExecStart=/usr/bin/jackd --name JerzyMultiFX --no-realtime -d alsa --device ${MULTIFX_DEVICE} -r 48000 -p 128 -n 3
Restart=on-failure
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
