[Unit]
Description=Jerzy MultiFX shared DSP audio host
After=jerzy-multifx-jack.service
Requires=jerzy-multifx-jack.service
[Service]
User=jerzymultifx
Environment=JACK_DEFAULT_SERVER=JerzyMultiFX
Environment=MULTIFX_DATA=/var/lib/jerzy-multifx
ExecStart=/opt/jerzy-multifx/bin/jerzy-multifx
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jerzy-multifx
[Install]
WantedBy=multi-user.target
